# If not running interactively, don't do anything
[ -z "$PS1" ] && return

export DOTFILES="$HOME/.dotfiles/companygardener"

. $DOTFILES/bash/env
. $DOTFILES/bash/colors
. $DOTFILES/bash/git
. $DOTFILES/bash/aliases
. $DOTFILES/bash/functions
. $DOTFILES/bash/vbox_functions

. $DOTFILES/bash/scripts

# Ruby (zsh loads chruby through the oh-my-zsh plugin)
if [[ -e /opt/homebrew/opt/chruby/share/chruby/chruby.sh ]]; then
  . /opt/homebrew/opt/chruby/share/chruby/chruby.sh
  . /opt/homebrew/opt/chruby/share/chruby/auto.sh
  chruby ruby-4.0.6 # keep in sync with zshrc
fi

shopt -s checkwinsize
shopt -s cmdhist
shopt -s histappend

if [[ -f "$HOME/.bashrc.local" ]]; then
  . "$HOME/.bashrc.local"
fi

. $DOTFILES/bash/config
