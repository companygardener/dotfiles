# /.zshenv
# This file is read first (after /etc/zshenv) for all types of shells
# (login/non-login, interactive/non-interactive).

# Variables shared with bash
[[ -e ~/.env ]] && source ~/.env || true

# Zsh-specific variables

# Drop duplicate PATH entries (zsh keeps the first occurrence)
typeset -U path PATH

# Local zsh-specific variables
[[ -e ~/.zshenv.local ]] && source ~/.zshenv.local || true

# rustup (kept here so non-login `zsh -c` can find cargo)
. "$HOME/.cargo/env"

# vim: ft=zsh
