# ~/.env
# This file is read by bash and zsh (and maybe other shells).
#
# https://github.com/mika-fischer/dotfiles/blob/master/sh/env

# Environment variables

# MacVim locally (-f waits for the window to close), vim over SSH or off macOS
if [[ $OSTYPE == darwin* && -z $SSH_CONNECTION ]]; then
  export EDITOR='mvim -f'
else
  export EDITOR=vim
fi
export VISUAL=vim

export DOTFILES="$HOME/.dotfiles/companygardener"

export BIT_HOME="$HOME/tungsten/bits"
export BUNDLE_COOLDOWN=7
export RUBY_YJIT_ENABLE=1

export FULLNAME="Erik Peterson"
export EMAIL="thecompanygardener@gmail.com"

export LANG="en_US.UTF-8"

export LC_COLLATE="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"
export LC_MESSAGES="en_US.UTF-8"

# Help bash a bit
export ENV=~/.env
export BASH_ENV=~/.bash_env

# Try to set $TERM correctly (interactive shells only; warnings go to stderr
# so they never end up in a script's output)
if [[ $- == *i* && $TERM == xterm ]]; then
  if [ -z "$COLORTERM" ]; then
    if [ -z "$XTERM_VERSION" ]; then
      echo "Warning: Terminal wrongly calling itself 'xterm'." >&2
    else
      case "$XTERM_VERSION" in
        XTerm\(88\)) export TERM="xterm-88color"  ;;
        XTerm\(*\))  export TERM="xterm-256color" ;;
        XTerm) ;;
        *)
          echo "Warning: Unrecognized XTERM_VERSION: $XTERM_VERSION" >&2
          ;;
      esac
    fi
  else
    case "$COLORTERM" in
      gnome-terminal)
        # Those crafty Gnome folks require you to check COLORTERM,
        # but don't allow you to just *favor* the setting over TERM.
        # Instead you need to compare it and perform some guesses
        # based upon the value. This is, perhaps, too simplistic.
        export TERM="gnome-256color"
        ;;
      *)
        echo "Warning: Unrecognized COLORTERM: $COLORTERM" >&2
        ;;
    esac
  fi
fi

# Helper functions
remove_path() {
  local p=":$PATH:"
  while [[ $p == *":$1:"* ]]; do
    p="${p//":$1:"/:}"
  done
  p="${p#:}"
  export PATH="${p%:}"
}

# Adds $1 at the end unless it is already on PATH
append_path() {
  if [[ -d "$1" && ":$PATH:" != *":$1:"* ]]; then
    export PATH="$PATH:$1"
  fi
}

# Moves $1 to the front of PATH
prepend_path() {
  if [[ -d "$1" ]]; then
    remove_path "$1"
    export PATH="$1:$PATH"
  fi
}

append_path_var() {
  if [[ -d "$2" ]]; then
    eval export $1="\$$1:$2"
  fi
}

prepend_path_var() {
  if [[ -d "$2" ]]; then
    eval export $1="$2:\$$1"
  fi
}

# Local variables
[[ -e ~/.env.local ]] && source ~/.env.local || true

