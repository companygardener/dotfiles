# Functions shared by bash and zsh

unalias md 2>/dev/null
md() {
  mkdir -p "$@" && cd "$@"
}

up() {
  local d=""
  limit=$1
  for ((i=1; i <= limit; i++))
    do
      d=$d/..
    done

  d=$(echo $d | sed 's/^\///')

  if [ -z "$d" ]; then
    d=..
  fi

  cd $d
}

show-hidden-files() {
  defaults write com.apple.finder AppleShowAllFiles $1
  killall Finder
}

find-empty-folders() {
  find . -depth -type d -empty
}

kill-empty-folders() {
  find . -depth -type d -empty -exec rmdir "{}" \;
}

insert-dock-space-left() {
  defaults write com.apple.dock persistent-apps -array-add '{tile-data={}; tile-type="spacer-tile";}'
  killall Dock
}

insert-dock-space-right() {
  defaults write com.apple.dock persistent-others -array-add '{tile-data={}; tile-type="spacer-tile";}'
  killall Dock
}

cdgem() {
  cd `gem env gemdir`/gems
  cd `ls | grep $1 | sort | tail -1`
}

dirsize() {
  [ -n "$ZSH_VERSION" ] && setopt local_options null_glob
  du -shx * .[a-zA-Z0-9_]* 2> /dev/null | \
  egrep '^ *[0-9.]*[MG]' | sort -n > /tmp/list
  egrep '^ *[0-9.]*M' /tmp/list
  egrep '^ *[0-9.]*G' /tmp/list
  rm -rf /tmp/list
}

to-utf8() {
  iconv -c -t UTF-8 < $1 > /tmp/to-utf8
  diff $1 /tmp/to-utf8
}

# Copy the dotfiles working tree (no .git) to a host and run its installer,
# which needs Ruby there: copy-dotfiles <host>
copy-dotfiles() {
  if [ -z "$1" ]; then
    echo "usage: copy-dotfiles <host>" >&2
    return 1
  fi

  COPYFILE_DISABLE=1 tar -C "$DOTFILES" --exclude .git --no-xattrs -czf - . |
    ssh "$1" 'mkdir -p ~/.dotfiles/companygardener &&
              tar -C ~/.dotfiles/companygardener -xzf - &&
              ~/.dotfiles/companygardener/install'
}

fn_exists() {
  declare -f "$1" >/dev/null 2>&1
}

ff() {
  osascript -e 'tell application "Finder"' \
            -e "if (${1-1} <= (count Finder windows)) then" \
            -e "get POSIX path of (target of window ${1-1} as alias)" \
            -e 'else' \
            -e 'get POSIX path of (desktop as alias)' \
            -e 'end if' \
            -e 'end tell'
}

cdf() {
  cd "$(ff "$@")"
}

# extract comes from the oh-my-zsh plugin in zsh and bash/functions in bash
alias xt=extract

large-files() {
  for file in $(find / -type f -size +"$1" 2> /dev/null); do ls -lh $file; done
}

awksum() {
  awk -v col="${1:-1}" '
    !/^$/ { delta = $col - mean; mean += delta / NR; mean2 += delta * ($col - mean); sum += $col; count += 1; }

    NR == 1 { min = $col; max = $col }

    $col <= min && !/^$/ { min = $col }
    $col >= max && !/^$/ { max = $col }

    END { printf("%d lines -- sum: %d avg: %d stdev: %d min: %d max: %d\n", count, sum, mean, sqrt(mean2 / count), min, max); }'
}

awksumall() {
  awk -F"${1:-' '}" -f ~/.awk/numerical.awk
}

awksample() {
  split="$1"
  [ -z $1 ] && split=' '
  head -n "${2:-1}" | awk -F "$split" '{ print NR ": " $0; for(i = 1; i <= NF; ++i) print "\t" i ": " $i }'
}

gzdir() {
  tar -cf - . | pv -s $(du -s . | awk '{print $1}') | gzip > out.tgz
}

gdx() {
  git diff $1 --name-only | grep -v -E "$2" | xargs git diff -w $1 --
}

samplecolors() {
  convert $1 -colors 16 -depth 16 -unique-colors -scale 10000% png:- | open -fa Preview
}

sumit () {
  ruby -e '
    sums = []
    ARGF.each {|x| puts x; x.split.each_with_index {|x,i| sums[i] = (sums[i] || 0) + x.to_i }}
    puts sums.join(" ")
  '
}

loop() {
  local i=2 t=1 cond

  [ -z ${1//[0-9]/} ] && i=$1 && shift
  [ -z ${1//[0-9]/} ] && t=$1 && shift && cond=1
  while [ $t -gt 0 ]; do
    sleep $i
    [ $cond ] && : $((--t))
    $@
  done
}

clear_port() {
  lsof -t -i tcp:$1 | xargs kill -9
}

drop() {
  tail -c +$1 ${@:2}
}

curltime() {
  curl -w "   time_namelookup:  %{time_namelookup}\n\
      time_connect:  %{time_connect}\n\
   time_appconnect:  %{time_appconnect}\n\
  time_pretransfer:  %{time_pretransfer}\n\
     time_redirect:  %{time_redirect}\n\
time_starttransfer:  %{time_starttransfer}\n\
--------------------------\n\
        time_total:  %{time_total}\n" -o /dev/null -s "$1"
}

weather() {
  curl wttr.in/$1
}

