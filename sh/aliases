# Aliases shared by bash and zsh

if [[ $(uname) = Darwin ]]; then
  is_darwin=1

  alias app='open -a'

  alias ls='ls -G'
  alias ll='ls -lahG'
  alias lld='gls -lah --color=auto --group-directories-first'

  alias deleted='lsof | grep "(deleted)$"'

  alias pstree='pstree -g3 -w'

  alias stripcr="sed -i '' $'s/\r//'"

  alias mute="osascript -e 'set volume output muted true'"
  alias shout="osascript -e 'set volume 10'"

  alias soundfix="sudo pkill coreaudiod"

  alias xgrep='grep -C2 -EHIrns --color=auto'

  alias ipv6off='networksetup -setv6off Wi-Fi'
  alias ipv6on='networksetup -setv6automatic Wi-Fi'

  # Lock the screen now (Ctrl-Cmd-Q); CGSession was removed in macOS 11
  alias afk="osascript -e 'tell application \"System Events\" to keystroke \"q\" using {control down, command down}'"
  alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
  # Plain-HTTP requests on the default-route interface
  alias sniff='sudo ngrep -d "$(route -n get default | awk "/interface:/ {print \$2}")" -t "^(GET|POST) " "tcp and port 80"'

  alias uuid=uuidgen

  alias npmup="npm install -g npm"

  alias p='cd ~/code/projects'
else
  is_darwin=0

  alias ls='ls --color=auto'
  alias ll='ls -lah --color=auto'

  alias xgrep='grep -C2 -TEHIrns --color=auto'

  alias deleted='sudo lsof | grep "(deleted)$"'
fi

# For xterm-256color-italic
alias ssh="TERM=xterm-256color ssh"

alias dus='du -Psckx * | sort -nr'
alias dotfiles='cd $DOTFILES'

alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias iplocal="ipconfig getifaddr en0"
alias jsonfix="pbpaste | jq . | pbcopy"
alias path='echo -e ${PATH//:/\\n}'
alias psql='PAGER=$DOTFILES/bin/vimpager psql'

alias screen="screen -U"

alias fig=figlet

alias python=python3
alias pip=pip3

