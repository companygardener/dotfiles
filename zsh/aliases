# zsh/aliases
# Note: many zsh aliases are installed by oh-my-zsh plugins
#
# Shared aliases and functions
[[ -e $DOTFILES/sh/aliases ]] && source $DOTFILES/sh/aliases || true
[[ -e $DOTFILES/sh/functions ]] && source $DOTFILES/sh/functions || true

# zsh global aliases
alias -g G='| grep -i'

# zsh suffix aliases (when extension is ... open with ...)
alias -s rb=${EDITOR%% *} # without -f, so the terminal isn't blocked

# Start a fresh login shell (re-reads ~/.zprofile, so PATH changes apply too)
alias reload='exec zsh -l'
